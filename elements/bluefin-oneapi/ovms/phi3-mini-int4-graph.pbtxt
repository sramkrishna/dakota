# OVMS mediapipe graph for Phi-3-mini-int4 on Intel NPU.
#
# Generated by:
#   podman run --rm -v /tmp/ovms-work:/models:z,U \
#       docker.io/openvino/model_server:2026.3 \
#       --pull --source_model OpenVINO/Phi-3-mini-4k-instruct-int4-ov \
#              --model_repository_path /models --task text_generation
#
# Then hand-edited to:
#   - add `device: "NPU"` to force NPU inference (OVMS default is CPU).
#
# File created with: OpenVINO Model Server 2026.3.0.6f3df706b
# OVMS_GRAPH_QUEUE_MAX_SIZE: AUTO

    input_stream: "HTTP_REQUEST_PAYLOAD:input"
    output_stream: "HTTP_RESPONSE_PAYLOAD:output"
    node: {
    name: "LLMExecutor"
    calculator: "HttpLLMCalculator"
    input_stream: "LOOPBACK:loopback"
    input_stream: "HTTP_REQUEST_PAYLOAD:input"
    input_side_packet: "LLM_NODE_RESOURCES:llm"
    input_side_packet: "LLM_NODE_EXECUTION_CONTEXTS:llm_ctx"
    output_stream: "LOOPBACK:loopback"
    output_stream: "HTTP_RESPONSE_PAYLOAD:output"
    input_stream_info: {
        tag_index: 'LOOPBACK:0',
        back_edge: true
    }
    node_options: {
        [type.googleapis.com / mediapipe.LLMCalculatorOptions]: {
            max_num_seqs:256,
            models_path: "./",
            enable_prefix_caching: true,
            cache_size: 0,
            device: "NPU",
        }
    }
    input_stream_handler {
        input_stream_handler: "SyncSetInputStreamHandler",
        options {
        [mediapipe.SyncSetInputStreamHandlerOptions.ext] {
            sync_set {
            tag_index: "LOOPBACK:0"
            }
        }
        }
    }
    }
